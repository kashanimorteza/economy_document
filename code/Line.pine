//*********************************************************************************************************************************
// Action
//*********************************************************************************************************************************
//*************************
//*** Day
//*************************
//----------
//Last
//----------
if timeframe.change("D") 
    //------Clear
    //---Line
    line.delete(day_last_open_line)
    line.delete(day_last_high_line)
    line.delete(day_last_low_line)
    line.delete(day_last_close_line)
    //---Label
    label.delete(day_last_open_label)
    label.delete(day_last_high_label)
    label.delete(day_last_low_label)
    label.delete(day_last_close_label)
    //------Draw
    //---Open
    if day_last_open_enable            
        style = day_last_open_style == "Solid" ? line.style_solid : day_last_open_style == "Dashed" ? line.style_dashed : line.style_dotted
        day_last_open_line := line.new(day_last_open_index, day_last_open_price, day_last_open_index+1, day_last_open_price, color=day_last_open_color, width=day_last_open_with, style=style, extend=extend.right)
        day_last_open_label := label.new(day_last_open_index, day_last_open_price, text = day_last_open_text, color=day_last_open_color_label, textcolor=day_last_open_color_text, style = label.style_label_down)
    //---High
    if day_last_high_enable
        style = day_last_high_style == "Solid" ? line.style_solid : day_last_high_style == "Dashed" ? line.style_dashed : line.style_dotted
        day_last_high_line := line.new(day_last_high_index, day_last_high_price, day_last_high_index+1, day_last_high_price, color=day_last_high_color, width=day_last_high_with, style=style, extend=extend.right)
        day_last_high_label := label.new(day_last_high_index, day_last_high_price, text = day_last_high_text, color=day_last_high_color_label, textcolor=day_last_high_color_text, style = label.style_label_down)
    //---Low
    if day_last_low_enable
        style = day_last_low_style == "Solid" ? line.style_solid : day_last_low_style == "Dashed" ? line.style_dashed : line.style_dotted
        day_last_low_line := line.new(day_last_low_index, day_last_low_price, day_last_low_index+1, day_last_low_price, color=day_last_low_color, width=day_last_low_with, style=style, extend=extend.right)
        day_last_low_label := label.new(day_last_low_index, day_last_low_price, text = day_last_low_text, color=day_last_low_color_label, textcolor=day_last_low_color_text, style = label.style_label_down)
    //---Close
    if day_last_close_enable
        style = day_last_close_style == "Solid" ? line.style_solid : day_last_close_style == "Dashed" ? line.style_dashed : line.style_dotted
        day_last_close_line := line.new(day_last_close_index, day_last_close_price, day_last_close_index+1, day_last_close_price, color=day_last_close_color, width=day_last_close_with, style=style, extend=extend.right)
        day_last_close_label := label.new(day_last_close_index, day_last_close_price, text = day_last_close_text, color=day_last_close_color_label, textcolor=day_last_close_color_text, style = label.style_label_down)
    //---Set
    day_last_open_index := bar_index
    day_last_open_price := open
    day_last_high_index := bar_index
    day_last_high_price := high
    day_last_low_index := bar_index
    day_last_low_price := low
    day_last_close_index := bar_index
    day_last_close_price := close
else
    if low < day_last_low_price
        day_last_low_index := bar_index
        day_last_low_price := low
    if high > day_last_high_price
        day_last_high_index := bar_index
        day_last_high_price := high
    day_last_close_index := bar_index    
    day_last_close_price := close

//*************************
//*** Week
//*************************
//----------
//This
//----------
if week_this_open_enable   
    if timeframe.change("W")    
        //------Clear
        //---Line
        line.delete(week_this_open_line)
        //---Label
        label.delete(week_this_open_label)
        //------Draw
        week_this_open_index := bar_index
        week_this_open_price := open
        style = week_this_open_style == "Solid" ? line.style_solid : week_this_open_style == "Dashed" ? line.style_dashed : line.style_dotted
        week_this_open_line := line.new(week_this_open_index, week_this_open_price, week_this_open_index+1, week_this_open_price, color=week_this_open_color, width=week_this_open_with, style=style, extend=extend.right)
        week_this_open_label := label.new(week_this_open_index, week_this_open_price, text = week_this_open_text, color=week_this_open_color_label, textcolor=week_this_open_color_text, style = label.style_label_down)
//----------
//Last
//----------
if timeframe.change("W") 
    //------Clear
    //---Line
    line.delete(week_last_open_line)
    line.delete(week_last_high_line)
    line.delete(week_last_low_line)
    line.delete(week_last_close_line)
    //---Label
    label.delete(week_last_open_label)
    label.delete(week_last_high_label)
    label.delete(week_last_low_label)
    label.delete(week_last_close_label)
    //------Draw
    //---Open
    if week_last_open_enable            
        style = week_last_open_style == "Solid" ? line.style_solid : week_last_open_style == "Dashed" ? line.style_dashed : line.style_dotted
        week_last_open_line := line.new(week_last_open_index, week_last_open_price, week_last_open_index+1, week_last_open_price, color=week_last_open_color, width=week_last_open_with, style=style, extend=extend.right)
        week_last_open_label := label.new(week_last_open_index, week_last_open_price, text = week_last_open_text, color=week_last_open_color_label, textcolor=week_last_open_color_text, style = label.style_label_down)
    //---High
    if week_last_high_enable
        style = week_last_high_style == "Solid" ? line.style_solid : week_last_high_style == "Dashed" ? line.style_dashed : line.style_dotted
        week_last_high_line := line.new(week_last_high_index, week_last_high_price, week_last_high_index+1, week_last_high_price, color=week_last_high_color, width=week_last_high_with, style=style, extend=extend.right)
        week_last_high_label := label.new(week_last_high_index, week_last_high_price, text = week_last_high_text, color=week_last_high_color_label, textcolor=week_last_high_color_text, style = label.style_label_down)
    //---Low
    if week_last_low_enable
        style = week_last_low_style == "Solid" ? line.style_solid : week_last_low_style == "Dashed" ? line.style_dashed : line.style_dotted
        week_last_low_line := line.new(week_last_low_index, week_last_low_price, week_last_low_index+1, week_last_low_price, color=week_last_low_color, width=week_last_low_with, style=style, extend=extend.right)
        week_last_low_label := label.new(week_last_low_index, week_last_low_price, text = week_last_low_text, color=week_last_low_color_label, textcolor=week_last_low_color_text, style = label.style_label_down)
    //---Close
    if week_last_close_enable
        style = week_last_close_style == "Solid" ? line.style_solid : week_last_close_style == "Dashed" ? line.style_dashed : line.style_dotted
        week_last_close_line := line.new(week_last_close_index, week_last_close_price, week_last_close_index+1, week_last_close_price, color=week_last_close_color, width=week_last_close_with, style=style, extend=extend.right)
        week_last_close_label := label.new(week_last_close_index, week_last_close_price, text = week_last_close_text, color=week_last_close_color_label, textcolor=week_last_close_color_text, style = label.style_label_down)
    //---Set
    week_last_open_index := bar_index
    week_last_open_price := open
    week_last_high_index := bar_index
    week_last_high_price := high
    week_last_low_index := bar_index
    week_last_low_price := low
    week_last_close_index := bar_index
    week_last_close_price := close
else
    if low < week_last_low_price
        week_last_low_index := bar_index
        week_last_low_price := low
    if high > week_last_high_price
        week_last_high_index := bar_index
        week_last_high_price := high
    week_last_close_index := bar_index    
    week_last_close_price := close

//*************************
//*** Month
//*************************
//----------
//This
//----------
if month_this_open_enable   
    if timeframe.change("M")    
        //------Clear
        //---Line
        line.delete(month_this_open_line)
        //---Label
        label.delete(month_this_open_label)
        //------Draw
        month_this_open_index := bar_index
        month_this_open_price := open
        style = month_this_open_style == "Solid" ? line.style_solid : month_this_open_style == "Dashed" ? line.style_dashed : line.style_dotted
        month_this_open_line := line.new(month_this_open_index, month_this_open_price, month_this_open_index+1, month_this_open_price, color=month_this_open_color, width=month_this_open_with, style=style, extend=extend.right)
        month_this_open_label := label.new(month_this_open_index, month_this_open_price, text = month_this_open_text, color=month_this_open_color_label, textcolor=month_this_open_color_text, style = label.style_label_down)
//----------
//Last
//----------
if timeframe.change("M") 
    //------Clear
    //---Line
    line.delete(month_last_open_line)
    line.delete(month_last_high_line)
    line.delete(month_last_low_line)
    line.delete(month_last_close_line)
    //---Label
    label.delete(month_last_open_label)
    label.delete(month_last_high_label)
    label.delete(month_last_low_label)
    label.delete(month_last_close_label)
    //------Draw
    //---Open
    if month_last_open_enable            
        style = month_last_open_style == "Solid" ? line.style_solid : month_last_open_style == "Dashed" ? line.style_dashed : line.style_dotted
        month_last_open_line := line.new(month_last_open_index, month_last_open_price, month_last_open_index+1, month_last_open_price, color=month_last_open_color, width=month_last_open_with, style=style, extend=extend.right)
        month_last_open_label := label.new(month_last_open_index, month_last_open_price, text = month_last_open_text, color=month_last_open_color_label, textcolor=month_last_open_color_text, style = label.style_label_down)
    //---High
    if month_last_high_enable
        style = month_last_high_style == "Solid" ? line.style_solid : month_last_high_style == "Dashed" ? line.style_dashed : line.style_dotted
        month_last_high_line := line.new(month_last_high_index, month_last_high_price, month_last_high_index+1, month_last_high_price, color=month_last_high_color, width=month_last_high_with, style=style, extend=extend.right)
        month_last_high_label := label.new(month_last_high_index, month_last_high_price, text = month_last_high_text, color=month_last_high_color_label, textcolor=month_last_high_color_text, style = label.style_label_down)
    //---Low
    if month_last_low_enable
        style = month_last_low_style == "Solid" ? line.style_solid : month_last_low_style == "Dashed" ? line.style_dashed : line.style_dotted
        month_last_low_line := line.new(month_last_low_index, month_last_low_price, month_last_low_index+1, month_last_low_price, color=month_last_low_color, width=month_last_low_with, style=style, extend=extend.right)
        month_last_low_label := label.new(month_last_low_index, month_last_low_price, text = month_last_low_text, color=month_last_low_color_label, textcolor=month_last_low_color_text, style = label.style_label_down)
    //---Close
    if month_last_close_enable
        style = month_last_close_style == "Solid" ? line.style_solid : month_last_close_style == "Dashed" ? line.style_dashed : line.style_dotted
        month_last_close_line := line.new(month_last_close_index, month_last_close_price, month_last_close_index+1, month_last_close_price, color=month_last_close_color, width=month_last_close_with, style=style, extend=extend.right)
        month_last_close_label := label.new(month_last_close_index, month_last_close_price, text = month_last_close_text, color=month_last_close_color_label, textcolor=month_last_close_color_text, style = label.style_label_down)
    //---Set
    month_last_open_index := bar_index
    month_last_open_price := open
    month_last_high_index := bar_index
    month_last_high_price := high
    month_last_low_index := bar_index
    month_last_low_price := low
    month_last_close_index := bar_index
    month_last_close_price := close
else
    if low < month_last_low_price
        month_last_low_index := bar_index
        month_last_low_price := low
    if high > month_last_high_price
        month_last_high_index := bar_index
        month_last_high_price := high
    month_last_close_index := bar_index    
    month_last_close_price := close

//*************************
//*** Asia
//*************************
//----------
//This-Open
//----------
if day_this_asia_open_enable and in_this_day and asia_startSession
    day_this_asia_open_index := bar_index
    day_this_asia_open_price := open
    day_this_asia_open_line:=line.new(day_this_asia_open_index, day_this_asia_open_price, day_this_asia_open_index+1, day_this_asia_open_price, color=day_this_asia_open_color, width=day_this_asia_open_with, style=day_this_asia_open_style_value, extend=extend.right)
    day_this_asia_open_label :=label.new(day_this_asia_open_index, day_this_asia_open_price, text = day_this_asia_open_text, color=day_this_asia_open_color_label, textcolor=day_this_asia_open_color_text, style = label.style_label_down)
//----------
//This-High
//----------
if day_this_asia_high_enable and in_this_day 
    //------Start
    if asia_startSession
        //---Index
        day_this_asia_high_index := bar_index
        //---Price
        day_this_asia_high_price := high
    //------Update
    if asia_inSession 
        //---Clear
        line.delete(day_this_asia_high_line)
        //---High
        if high >= day_this_asia_high_price
            day_this_asia_high_index := bar_index
            day_this_asia_high_price := high
        //---Draw        
        day_this_asia_high_line:=line.new(day_this_asia_high_index, day_this_asia_high_price, day_this_asia_high_index+1, day_this_asia_high_price, color=day_this_asia_high_color, width=day_this_asia_high_with, style=day_this_asia_high_style_value, extend=extend.right)
        label.delete(day_this_asia_high_label)
        day_this_asia_high_label :=label.new(day_this_asia_high_index, day_this_asia_high_price, text = day_this_asia_high_text, color=day_this_asia_high_color_label, textcolor=day_this_asia_high_color_text, style = label.style_label_down)
//----------
//This-Low
//----------
if day_this_asia_low_enable and in_this_day
    //------Start
    if asia_startSession
        //---Index
        day_this_asia_low_index := bar_index
        //---Price
        day_this_asia_low_price := low
    //------Update
    if asia_inSession 
        //---Clear
        line.delete(day_this_asia_low_line)
        //---Low
        if low <= day_this_asia_low_price
            day_this_asia_low_index := bar_index
            day_this_asia_low_price := low
        //---Draw        
        day_this_asia_low_line:=line.new(day_this_asia_low_index, day_this_asia_low_price, day_this_asia_low_index+1, day_this_asia_low_price, color=day_this_asia_low_color, width=day_this_asia_low_with, style=day_this_asia_low_style_value, extend=extend.right)
        label.delete(day_this_asia_low_label)
        day_this_asia_low_label :=label.new(day_this_asia_low_index, day_this_asia_low_price, text = day_this_asia_low_text, color=day_this_asia_low_color_label, textcolor=day_this_asia_low_color_text, style = label.style_label_down)
//----------
//This-Close
//----------
if day_this_asia_close_enable and in_this_day
    //------Start
    if asia_inSession 
        //---Clear
        line.delete(day_this_asia_close_line)
        //---Close
        day_this_asia_close_index := bar_index
        day_this_asia_close_price := close
        //---Draw        
