//----------
//Asia
//----------
asia_inSession    = not na(time(timeframe.period, asia_session, general_tz))
asia_startSession = asia_inSession and not asia_inSession[1]
asia_endSession   = not asia_inSession and asia_inSession[1]
asia_today_start = start_session(asia_session)

