//*************************
//*** General
//*************************
general_tz= input.string("Europe/Moscow","Time Zone",options = ["Europe/Moscow","UTC","Europe/London","America/New_York","Asia/Tokyo","Asia/Dubai"], group="-------------------- General", inline = '1')
asia_session = input.session("0000-0800", "Asia", group="-------------------- General", inline = '2')
uk_session = input.session("1000-1800", "Uk", group="-------------------- General", inline = '3')
usa_session = input.session("1500-2400", "Usa", group="-------------------- General", inline = '4')



//*********************************************************************************************************************************
// Method
//*********************************************************************************************************************************
//*************************
//*** General
//*************************
in_this_year = year(time, general_tz) == year(timenow, general_tz) 
in_this_month = year(time, general_tz) == year(timenow, general_tz) and month(time, general_tz) == month(timenow, general_tz) 
in_this_week = year(time, general_tz) == year(timenow, general_tz) and month(time, general_tz) == month(timenow, general_tz) 
in_this_day = year(time, general_tz) == year(timenow, general_tz) and month(time, general_tz) == month(timenow, general_tz) and weekofyear(time, general_tz) == weekofyear(timenow, general_tz) and dayofmonth(time, general_tz) == dayofmonth(timenow, general_tz)

//------------
//start_session
//------------
start_session(session) =>
    start_hour   = int(str.tonumber(str.substring(session, 0, 2)))
    start_minute = int(str.tonumber(str.substring(session, 2, 4)))
    end_hour     = int(str.tonumber(str.substring(session, 5, 7)))
    end_minute   = int(str.tonumber(str.substring(session, 7, 9)))
    current_hour   = hour(timenow, general_tz)
    current_minute = minute(timenow, general_tz)
    current_hour > start_hour or (current_hour == start_hour and current_minute >= start_minute)
    
//------------
//f_get_month
//------------
f_get_month(_time) =>
    //------Variable
    int m = month(_time)
    int d = dayofmonth(_time)
    //------Action
    m := d > 1 ? m + 1 : m
    m := m > 12 ? 1 : m
    //------return
    m
//------------
//is_this_year
//------------
is_this_year() =>
    if year(timenow) == year(time)
        true
    else
        false
//-------------
//is_this_month
//-------------
is_this_month() =>
    if is_this_year()
        if month(timenow) == month(time)
            true
        else
            false

//-------------
//is_this_week
//-------------
is_this_week() =>
    if is_this_month()
        if weekofyear(timenow) == weekofyear(time)
            true
        else
            false
//-------------
//is_this_day
//-------------
is_this_day() =>
    if is_this_month()
        if dayofmonth(timenow) == dayofmonth(time)
            true
        else
            false



