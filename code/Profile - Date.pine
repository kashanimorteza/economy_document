            month_live_line_3 := line.new(month_live_low_index, month_live_low_price, bar_index, close, color=month_live_color_profile, width=month_width, style=month_style_value)
        else
            month_live_line_1 := line.new(month_live_open_index, month_live_open_price, month_live_low_index, month_live_low_price, color=month_live_color_profile, width=month_width, style=month_style_value)
            month_live_line_2 := line.new(month_live_low_index, month_live_low_price, month_live_high_index, month_live_high_price, color=month_live_color_profile, width=month_width, style=month_style_value)
