        label.delete(h1_live_label_4)
        //---Color
        h1_live_color_profile := h1_live_close_price >= h1_live_open_price ? h1_color_bullish : h1_color_bearish
        //---Line
        if h1_live_high_index < h1_live_low_index
            h1_live_line_1 := line.new(h1_live_open_index, h1_live_open_price, h1_live_high_index, h1_live_high_price, color=h1_live_color_profile, width=h1_width, style=h1_style_value)
            h1_live_line_2 := line.new(h1_live_high_index, h1_live_high_price, h1_live_low_index, h1_live_low_price, color=h1_live_color_profile, width=h1_width, style=h1_style_value)
            h1_live_line_3 := line.new(h1_live_low_index, h1_live_low_price, bar_index, close, color=h1_live_color_profile, width=h1_width, style=h1_style_value)
        else
            h1_live_line_1 := line.new(h1_live_open_index, h1_live_open_price, h1_live_low_index, h1_live_low_price, color=h1_live_color_profile, width=h1_width, style=h1_style_value)
            h1_live_line_2 := line.new(h1_live_low_index, h1_live_low_price, h1_live_high_index, h1_live_high_price, color=h1_live_color_profile, width=h1_width, style=h1_style_value)
            h1_live_line_3 := line.new(h1_live_high_index, h1_live_high_price, bar_index, close, color=h1_live_color_profile, width=h1_width, style=h1_style_value)
        //---Label
        if h1_label_enable or h1_all_enable
            if h1_live_high_index < h1_live_low_index
                h1_live_label_1 := label.new(h1_live_open_index, h1_live_open_price, text =str.tostring(math.round((h1_live_high_price - h1_live_open_price) * 10000)) , style = h1_live_label_movement_style, color = h1_live_color_profile, textcolor = h1_live_label_movement_color)
                h1_live_label_2 := label.new(h1_live_high_index, h1_live_high_price, text =str.tostring(math.round((h1_live_high_price - h1_live_low_price) * 10000)) , style = h1_live_label_movement_style, color = h1_live_color_profile, textcolor = h1_live_label_movement_color)
                h1_live_label_3 := label.new(h1_live_low_index, h1_live_low_price, text =str.tostring(math.round((h1_live_close_price - h1_live_low_price) * 10000)) , style = h1_live_label_movement_style, color = h1_live_color_profile, textcolor = h1_live_label_movement_color)
            else   
                h1_live_label_1 := label.new(h1_live_open_index, h1_live_open_price, text =str.tostring(math.round((h1_live_open_price - h1_live_low_price) * 10000)) , style = h1_live_label_movement_style, color = h1_live_color_profile, textcolor = h1_live_label_movement_color)
                h1_live_label_2 := label.new(h1_live_low_index, h1_live_low_price, text =str.tostring(math.round((h1_live_high_price - h1_live_low_price) * 10000)) , style = h1_live_label_movement_style, color = h1_live_color_profile, textcolor = h1_live_label_movement_color)
                h1_live_label_3 := label.new(h1_live_high_index, h1_live_high_price, text =str.tostring(math.round((h1_live_high_price - h1_live_close_price) * 10000)) , style = h1_live_label_movement_style, color = h1_live_color_profile, textcolor =h1_live_label_movement_color)
        //------Total
        if h1_total_enable or h1_all_enable
            h1_live_line_4 := line.new(h1_live_open_index, h1_live_open_price, h1_live_close_index, h1_live_close_price, color=h1_live_color_profile, width=h1_width, style=h1_live_line_total_style)
            i = h1_live_open_index+((h1_live_close_index - h1_live_open_index)/2)
            p = h1_live_open_price+((h1_live_close_price - h1_live_open_price)/2)
            t = str.tostring(math.round((h1_live_close_price - h1_live_open_price) * 10000))
            h1_live_label_4 := label.new(i, p, text =t , style =h1_live_label_total_style, color = h1_live_color_profile, textcolor =h1_live_label_total_color)