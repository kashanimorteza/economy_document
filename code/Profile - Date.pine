        //---Line
        if h4_past_high_index < h4_past_low_index
            array.push(h4_past_line_movement, line.new(h4_past_open_index, h4_past_open_price, h4_past_high_index, h4_past_high_price, color=h4_past_color_profile, width=h4_width, style=h4_style_value))
