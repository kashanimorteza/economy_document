//*********************************************************************************************************************************
// Action
//*********************************************************************************************************************************
//*************************
//*** Month
//*************************
//----------
//Past
//----------
if month_past_enable or month_all_enable
    //------Start
    if timeframe.change("M")
        //---Color
        month_past_color_profile := month_past_close_price >= month_past_open_price ? month_color_bullish : month_color_bearish
        //---Line
        if month_past_high_index < month_past_low_index
            array.push(month_past_line_movement, line.new(month_past_open_index, month_past_open_price, month_past_high_index, month_past_high_price, color=month_past_color_profile, width=month_width, style=month_style_value))
            array.push(month_past_line_movement, line.new(month_past_high_index, month_past_high_price, month_past_low_index, month_past_low_price, color=month_past_color_profile, width=month_width, style=month_style_value))
            array.push(month_past_line_movement, line.new(month_past_low_index, month_past_low_price, month_past_close_index, month_past_close_price, color=month_past_color_profile, width=month_width, style=month_style_value))
        else
            array.push(month_past_line_movement, line.new(month_past_open_index, month_past_open_price, month_past_low_index, month_past_low_price, color=month_past_color_profile, width=month_width, style=month_style_value))
            array.push(month_past_line_movement, line.new(month_past_low_index, month_past_low_price, month_past_high_index, month_past_high_price, color=month_past_color_profile, width=month_width, style=month_style_value))
            array.push(month_past_line_movement, line.new(month_past_high_index, month_past_high_price, month_past_close_index, month_past_close_price, color=month_past_color_profile, width=month_width, style=month_style_value))
        //---Label
        if month_label_enable or month_all_enable
            if month_past_high_index < month_past_low_index
                array.push(month_past_label_movement, label.new(month_past_open_index, month_past_open_price, text =str.tostring(math.round((month_past_high_price - month_past_open_price) * 10000)) , style = month_past_label_movement_style, color = month_past_color_profile, textcolor = month_past_label_movement_color))
                array.push(month_past_label_movement, label.new(month_past_high_index, month_past_high_price, text =str.tostring(math.round((month_past_high_price - month_past_low_price) * 10000)) , style = month_past_label_movement_style, color = month_past_color_profile, textcolor = month_past_label_movement_color))
                array.push(month_past_label_movement, label.new(month_past_low_index, month_past_low_price, text =str.tostring(math.round((month_past_close_price - month_past_low_price) * 10000)) , style = month_past_label_movement_style, color = month_past_color_profile, textcolor = month_past_label_movement_color))
            else   
                array.push(month_past_label_movement, label.new(month_past_open_index, month_past_open_price, text =str.tostring(math.round((month_past_open_price - month_past_low_price) * 10000)) , style = month_past_label_movement_style, color = month_past_color_profile, textcolor = month_past_label_movement_color))
                array.push(month_past_label_movement, label.new(month_past_low_index, month_past_low_price, text =str.tostring(math.round((month_past_high_price - month_past_low_price) * 10000)) , style = month_past_label_movement_style, color = month_past_color_profile, textcolor = month_past_label_movement_color))
                array.push(month_past_label_movement, label.new(month_past_high_index, month_past_high_price, text =str.tostring(math.round((month_past_high_price - month_past_close_price) * 10000)) , style = month_past_label_movement_style, color = month_past_color_profile, textcolor =month_past_label_movement_color))
        //---Total
        if month_total_enable or month_all_enable
            array.push(month_past_line_total, line.new(month_past_open_index, month_past_open_price, month_past_close_index, month_past_close_price, color=month_past_color_profile, width=month_width, style=month_past_line_total_style))
            i = month_past_open_index+((month_past_close_index - month_past_open_index)/2)
            p = month_past_open_price+((month_past_close_price - month_past_open_price)/2)
            t = str.tostring(math.round((month_past_close_price - month_past_open_price) * 10000))
            array.push(month_past_label_total, label.new(i, p, text =t , style =month_past_label_total_style, color = month_past_color_profile, textcolor =month_past_label_total_color))
        //---Limit
        //Movement
        while array.size(month_past_line_movement) > month_limit * 3
            line.delete(array.shift(month_past_line_movement))
        while array.size(month_past_label_movement) > month_limit * 3
            label.delete(array.shift(month_past_label_movement))
        //Total
        while array.size(month_past_line_total) > month_limit
            line.delete(array.shift(month_past_line_total))
        while array.size(month_past_label_total) > month_limit
            label.delete(array.shift(month_past_label_total))
        //--Set
        month_past_open_index := bar_index
        month_past_high_index := bar_index
        month_past_low_index  := bar_index
        month_past_close_index := bar_index
        month_past_open_price := open
        month_past_high_price := high
        month_past_low_price  := low
        month_past_close_price := close
    //------Update
    //---High
    if high >= nz(month_past_high_price, high)
        month_past_high_price := high
        month_past_high_index := bar_index
    //---Low
    if low <= nz(month_past_low_price, low)
        month_past_low_price := low
        month_past_low_index := bar_index
    //---Close
    month_past_close_price := close
    month_past_close_index := bar_index
//----------
//Live
//----------
if (month_live_enable or month_all_enable) 
    //------Start
    if timeframe.change("M") and in_this_month
