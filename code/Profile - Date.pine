        day_live_close_price := close
        day_live_close_index := bar_index
        //---Clear
        line.delete(day_live_line_1)
        line.delete(day_live_line_2)
        line.delete(day_live_line_3)
        line.delete(day_live_line_4)
        label.delete(day_live_label_1)
        label.delete(day_live_label_2)
        label.delete(day_live_label_3)
        label.delete(day_live_label_4)
        //---Color
        day_live_color_profile := day_live_close_price >= day_live_open_price ? day_color_bullish : day_color_bearish
        //---Line
        if day_live_high_index < day_live_low_index
            day_live_line_1 := line.new(day_live_open_index, day_live_open_price, day_live_high_index, day_live_high_price, color=day_live_color_profile, width=day_width, style=day_style_value)
            day_live_line_2 := line.new(day_live_high_index, day_live_high_price, day_live_low_index, day_live_low_price, color=day_live_color_profile, width=day_width, style=day_style_value)
            day_live_line_3 := line.new(day_live_low_index, day_live_low_price, bar_index, close, color=day_live_color_profile, width=day_width, style=day_style_value)
        else
            day_live_line_1 := line.new(day_live_open_index, day_live_open_price, day_live_low_index, day_live_low_price, color=day_live_color_profile, width=day_width, style=day_style_value)
            day_live_line_2 := line.new(day_live_low_index, day_live_low_price, day_live_high_index, day_live_high_price, color=day_live_color_profile, width=day_width, style=day_style_value)
            day_live_line_3 := line.new(day_live_high_index, day_live_high_price, bar_index, close, color=day_live_color_profile, width=day_width, style=day_style_value)
        //---Label
        if day_label_enable or day_all_enable
            if day_live_high_index < day_live_low_index
                day_live_label_1 := label.new(day_live_open_index, day_live_open_price, text =str.tostring(math.round((day_live_high_price - day_live_open_price) * 10000)) , style = day_live_label_movement_style, color = day_live_color_profile, textcolor = day_live_label_movement_color)
                day_live_label_2 := label.new(day_live_high_index, day_live_high_price, text =str.tostring(math.round((day_live_high_price - day_live_low_price) * 10000)) , style = day_live_label_movement_style, color = day_live_color_profile, textcolor = day_live_label_movement_color)
                day_live_label_3 := label.new(day_live_low_index, day_live_low_price, text =str.tostring(math.round((day_live_close_price - day_live_low_price) * 10000)) , style = day_live_label_movement_style, color = day_live_color_profile, textcolor = day_live_label_movement_color)
            else   
                day_live_label_1 := label.new(day_live_open_index, day_live_open_price, text =str.tostring(math.round((day_live_open_price - day_live_low_price) * 10000)) , style = day_live_label_movement_style, color = day_live_color_profile, textcolor = day_live_label_movement_color)
                day_live_label_2 := label.new(day_live_low_index, day_live_low_price, text =str.tostring(math.round((day_live_high_price - day_live_low_price) * 10000)) , style = day_live_label_movement_style, color = day_live_color_profile, textcolor = day_live_label_movement_color)
                day_live_label_3 := label.new(day_live_high_index, day_live_high_price, text =str.tostring(math.round((day_live_high_price - day_live_close_price) * 10000)) , style = day_live_label_movement_style, color = day_live_color_profile, textcolor =day_live_label_movement_color)
        //------Total
        if day_total_enable or day_all_enable
            day_live_line_4 := line.new(day_live_open_index, day_live_open_price, day_live_close_index, day_live_close_price, color=day_live_color_profile, width=day_width, style=day_live_line_total_style)
            i = day_live_open_index+((day_live_close_index - day_live_open_index)/2)
            p = day_live_open_price+((day_live_close_price - day_live_open_price)/2)
            t = str.tostring(math.round((day_live_close_price - day_live_open_price) * 10000))
            day_live_label_4 := label.new(i, p, text =t , style =day_live_label_total_style, color = day_live_color_profile, textcolor =day_live_label_total_color)

