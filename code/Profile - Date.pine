            array.push(h4_past_line_movement, line.new(h4_past_low_index, h4_past_low_price, h4_past_close_index, h4_past_close_price, color=h4_past_color_profile, width=h4_width, style=h4_style_value))
        else
            array.push(h4_past_line_movement, line.new(h4_past_open_index, h4_past_open_price, h4_past_low_index, h4_past_low_price, color=h4_past_color_profile, width=h4_width, style=h4_style_value))
            array.push(h4_past_line_movement, line.new(h4_past_low_index, h4_past_low_price, h4_past_high_index, h4_past_high_price, color=h4_past_color_profile, width=h4_width, style=h4_style_value))
            array.push(h4_past_line_movement, line.new(h4_past_high_index, h4_past_high_price, h4_past_close_index, h4_past_close_price, color=h4_past_color_profile, width=h4_width, style=h4_style_value))
        //---Label
        if h4_label_enable or h4_all_enable
            if h4_past_high_index < h4_past_low_index
                array.push(h4_past_label_movement, label.new(h4_past_open_index, h4_past_open_price, text =str.tostring(math.round((h4_past_high_price - h4_past_open_price) * 10000)) , style = h4_past_label_movement_style, color = h4_past_color_profile, textcolor = h4_past_label_movement_color))
                array.push(h4_past_label_movement, label.new(h4_past_high_index, h4_past_high_price, text =str.tostring(math.round((h4_past_high_price - h4_past_low_price) * 10000)) , style = h4_past_label_movement_style, color = h4_past_color_profile, textcolor = h4_past_label_movement_color))
                array.push(h4_past_label_movement, label.new(h4_past_low_index, h4_past_low_price, text =str.tostring(math.round((h4_past_close_price - h4_past_low_price) * 10000)) , style = h4_past_label_movement_style, color = h4_past_color_profile, textcolor = h4_past_label_movement_color))
            else   
                array.push(h4_past_label_movement, label.new(h4_past_open_index, h4_past_open_price, text =str.tostring(math.round((h4_past_open_price - h4_past_low_price) * 10000)) , style = h4_past_label_movement_style, color = h4_past_color_profile, textcolor = h4_past_label_movement_color))
                array.push(h4_past_label_movement, label.new(h4_past_low_index, h4_past_low_price, text =str.tostring(math.round((h4_past_high_price - h4_past_low_price) * 10000)) , style = h4_past_label_movement_style, color = h4_past_color_profile, textcolor = h4_past_label_movement_color))
                array.push(h4_past_label_movement, label.new(h4_past_high_index, h4_past_high_price, text =str.tostring(math.round((h4_past_high_price - h4_past_close_price) * 10000)) , style = h4_past_label_movement_style, color = h4_past_color_profile, textcolor =h4_past_label_movement_color))
        //---Total
        if h4_total_enable or h4_all_enable
            array.push(h4_past_line_total, line.new(h4_past_open_index, h4_past_open_price, h4_past_close_index, h4_past_close_price, color=h4_past_color_profile, width=h4_width, style=h4_past_line_total_style))
            i = h4_past_open_index+((h4_past_close_index - h4_past_open_index)/2)
            p = h4_past_open_price+((h4_past_close_price - h4_past_open_price)/2)
            t = str.tostring(math.round((h4_past_close_price - h4_past_open_price) * 10000))
            array.push(h4_past_label_total, label.new(i, p, text =t , style =h4_past_label_total_style, color = h4_past_color_profile, textcolor =h4_past_label_total_color))
        //---Limit
        //Movement
        while array.size(h4_past_line_movement) > h4_limit * 3
            line.delete(array.shift(h4_past_line_movement))
        while array.size(h4_past_label_movement) > h4_limit * 3
            label.delete(array.shift(h4_past_label_movement))
        //Total
        while array.size(h4_past_line_total) > h4_limit
            line.delete(array.shift(h4_past_line_total))
        while array.size(h4_past_label_total) > h4_limit
            label.delete(array.shift(h4_past_label_total))
        //--Set
        h4_past_open_index := bar_index
        h4_past_high_index := bar_index
        h4_past_low_index  := bar_index
        h4_past_close_index := bar_index
        h4_past_open_price := open
        h4_past_high_price := high
        h4_past_low_price  := low
        h4_past_close_price := close
    //------Update
    //---High
    if high >= nz(h4_past_high_price, high)
        h4_past_high_price := high
        h4_past_high_index := bar_index
    //---Low
    if low <= nz(h4_past_low_price, low)
        h4_past_low_price := low
        h4_past_low_index := bar_index
    //---Close
    h4_past_close_price := close
    h4_past_close_index := bar_index
