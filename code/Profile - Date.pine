                month_live_label_2 := label.new(month_live_low_index, month_live_low_price, text =str.tostring(math.round((month_live_high_price - month_live_low_price) * 10000)) , style = month_live_label_movement_style, color = month_live_color_profile, textcolor = month_live_label_movement_color)
                month_live_label_3 := label.new(month_live_high_index, month_live_high_price, text =str.tostring(math.round((month_live_high_price - month_live_close_price) * 10000)) , style = month_live_label_movement_style, color = month_live_color_profile, textcolor =month_live_label_movement_color)
